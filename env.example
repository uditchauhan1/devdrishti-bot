# DevDrishti Bot Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# =============================================================================

# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=YourBotUsername

# Google Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Payment Gateway
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# OPTIONAL ENVIRONMENT VARIABLES
# =============================================================================

# Google Sheets Analytics (Optional)
# GOOGLE_CREDS_FILE=service-account.json
# SHEETS_ID=your_google_sheet_id

# Rate Limiting Configuration
# RATE_LIMIT_SECONDS=5
# MAX_REQUESTS_PER_HOUR=60

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. Telegram Bot:
#    - Message @BotFather on Telegram
#    - Send /newbot
#    - Get your BOT_TOKEN
#    - Set your BOT_USERNAME

# 2. Gemini API:
#    - Go to https://aistudio.google.com/app/apikey
#    - Create new API key
#    - Copy to GEMINI_API_KEY

# 3. Razorpay:
#    - Sign up at https://dashboard.razorpay.com/signup
#    - Complete KYC verification
#    - Get API keys from dashboard
#    - Use test keys for development: rzp_test_xxx
#    - Use live keys for production: rzp_live_xxx

# 4. For Railway.app deployment:
#    - Add these variables in Railway dashboard
#    - Do NOT commit this file with real values
#    - Keep your secrets secure! 