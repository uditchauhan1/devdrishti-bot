# DevDrishti Bot - Railway.app Environment Variables
# Set these in Railway dashboard under "Variables" tab

# =============================================================================
# REQUIRED ENVIRONMENT VARIABLES (Bot will not start without these)
# =============================================================================

# Telegram Bot Configuration
# Get from @BotFather: https://t.me/BotFather
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=YourBotUsername

# Google Gemini AI API
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# PAYMENT CONFIGURATION (Choose one or both)
# =============================================================================

# Option 1: Razorpay Payment Gateway (RECOMMENDED - Professional)
# Get from: https://dashboard.razorpay.com/app/keys
# Note: Requires KYC verification (2-3 days)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxx

# Option 2: UPI Direct Transfer (FALLBACK - Quick start)
# Your UPI ID for direct payments while Razorpay is pending
UPI_ID=yourname@paytm

# =============================================================================
# OPTIONAL ENVIRONMENT VARIABLES (Bot will use defaults if not set)
# =============================================================================

# Rate Limiting Configuration
RATE_LIMIT_SECONDS=5
MAX_REQUESTS_PER_HOUR=60

# Google Sheets Analytics (Optional - for sales tracking)
# GOOGLE_CREDS_FILE=service-account.json
# SHEETS_ID=your_google_sheet_id

# =============================================================================
# RAILWAY DEPLOYMENT INSTRUCTIONS
# =============================================================================

# QUICK START (Without Razorpay):
# 1. Add: BOT_TOKEN, BOT_USERNAME, GEMINI_API_KEY, UPI_ID
# 2. Deploy immediately - bot will work with UPI payments
# 3. Add Razorpay keys later when verification is complete

# FULL SETUP (With Razorpay):
# 1. Complete Razorpay KYC verification first
# 2. Add all variables including RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET
# 3. Deploy with professional payment gateway

# Important Notes:
# - Bot automatically detects available payment methods
# - UPI mode: Users transfer to your UPI ID manually
# - Razorpay mode: Professional payment gateway with cards/UPI/banking
# - You can start with UPI and upgrade to Razorpay anytime 